# ==============================================
# ExplorePakur - Environment Variables Template
# Copy this file to .env.local and add your real keys
# ==============================================

# Supabase PostgreSQL Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ImageKit.io CDN Media Storage
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# Admin Security
ADMIN_PASSWORD=your-secure-admin-password

# Site Domain (Update when custom domain is connected)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
